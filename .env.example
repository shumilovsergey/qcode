# qcode — local dev environment
# Copy to .env and fill in. .env is gitignored and never committed.

PORT=8890

# SQLite path — /data is the dev-compose volume mount (./data on the host)
DB_PATH=/data/qcode.db

# auth-center — public URL the browser is redirected to
AUTH_URL=https://auth-center.sh-development.ru

# auth-center — internal URL for the server-to-server /exchange + /delegate calls.
# Same as AUTH_URL unless this app runs on the same host as auth-center.
AUTH_INTERNAL=https://auth-center.sh-development.ru

# Public URL of THIS app — auth-center redirects back here after login
APP_URL=http://localhost:8890

# Secret registered in auth-center's APP_TOKENS. Never reaches the browser.
APP_TOKEN=

# Signing key for the JWT session cookie — any random string
SECRET_KEY=
